# Copy to .env.local for `npm run dev -w @lk/web`; on Cloudflare set the same two as build variables (not runtime variables: Vite inlines them).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or publishable key (public by design; row level security protects the data)>
