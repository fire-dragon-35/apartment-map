SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service role key; never commit the real .env>
TRAFIKLAB_GTFS_KEY=<Trafiklab GTFS Regional key (SL); used by the travel time matrix router>
APIFY_TOKEN=<Apify API token; the worker fetches the Facebook groups in apps/worker/facebook-groups.txt>
ANTHROPIC_API_KEY=<Anthropic API key; the worker reads each new Facebook post once with Claude Haiku>
